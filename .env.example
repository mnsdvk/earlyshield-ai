# Google AI Studio / Gemini API key (simplest for hackathon deployment)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Optional Vertex / Google Cloud mode instead of GEMINI_API_KEY
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Google Earth Engine
GEE_PROJECT_ID=
# For Streamlit Cloud, store the service-account JSON as one secret string.
GEE_CREDENTIALS_JSON=

# Optional real outbound municipal webhook
ALERT_WEBHOOK_URL=

# true keeps the deterministic fallback path available when a provider is unavailable
EARLYSHIELD_DEMO_MODE=true
